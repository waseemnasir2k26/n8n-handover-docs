{
  "name": "n8n-handover-docs",
  "version": "1.0.0",
  "description": "Generate a client handover pack (plain-English docs, Mermaid flowcharts, credential inventory, 'when it breaks' runbook) from n8n workflows.",
  "license": "MIT",
  "author": "Waseem Nasir <info@skynetjoe.com> (https://skynetjoe.com)",
  "bin": {
    "n8n-handover-docs": "bin/n8n-handover-docs.js"
  },
  "main": "src/generate.js",
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/n8n-handover-docs.js --from-dir examples/workflows --out examples/sample-pack --title \"Demo Client\" --date 2026-10-25"
  },
  "keywords": [
    "n8n",
    "documentation",
    "handover",
    "workflow",
    "mermaid",
    "automation"
  ]
}
